{
  // Deploying the whole openGym stack as one Worker: the API routes live in a Durable
  // Object (src/db.js), the built frontend (../frontend/dist) is this Worker's static
  // assets, so the app keeps the single origin its passkeys and CSRF guard are built on.
  "name": "gym",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "DB", "class_name": "Db" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Db"] }],
  // User-uploaded photos/videos (workers/src/media.js) — on Workers KV, not R2: the account
  // has no payment info on file and KV's free tier (1 GB, egress free) covers a household with
  // no card. The one tradeoff is KV's 25 MB value cap, so the video limit is clamped to 20 MB
  // in db.js. If R2 is ever enabled, the store takes an R2 binding unchanged (same three
  // operations) and the clamp can go.
  "kv_namespaces": [{ "binding": "MEDIA", "id": "922cdf4f4f5e4a86b1e97b4b9741f9c8" }],
  // The same variables the docker deployment reads (api/server.js). RP_ID must be the
  // hostname the site is served from — passkeys are bound to it — and ORIGIN its full
  // URL. Override per environment with `wrangler deploy --var RP_ID:...` or a config
  // per environment; nothing here is a secret.
  "vars": {
    "RP_ID": "gym.rin2401.workers.dev",
    "ORIGIN": "https://gym.rin2401.workers.dev",
    "RP_NAME": "openGym",
    // The Coach's admin dashboard (Settings → Coach) is how this instance is configured —
    // provider, base URL, key, model — so the owner's profile has to be the admin.
    "ADMIN_UIDS": "mDxFsIUTmhLr5beb",
    // Google sign-in (workers/src/db.js /api/auth/google). The client id is public; the
    // secret lives as a Worker secret (`wrangler secret put GOOGLE_CLIENT_SECRET`), not
    // here, so this file stays safe to commit. The redirect URI registered in Google Cloud
    // Console must be ORIGIN + /api/auth/google/callback.
    "GOOGLE_CLIENT_ID": "8089151908-abrk45ug6u2d70uvvqo3a2ckrrprd7fg.apps.googleusercontent.com"
  }
}
